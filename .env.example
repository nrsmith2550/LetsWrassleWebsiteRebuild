# ───────── Core ─────────
NODE_ENV=development
PORT=4000
# Public URL of the site (used in emails). Dev: the Vite URL.
SITE_URL=http://localhost:5173
# Only needed if the frontend is hosted on a DIFFERENT origin than the API
# (comma separated). Leave empty for the default single-process deployment.
CLIENT_URL=
# SQLite file (path is relative to prisma/schema.prisma). Swap provider/URL in
# schema.prisma to move to Postgres/libSQL.
DATABASE_URL="file:../data/store.db"

# ───────── Auth ─────────
# REQUIRED in production: long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string
# Set true when served over HTTPS
COOKIE_SECURE=false
# lax (same site) | none (frontend on another domain; requires COOKIE_SECURE=true)
COOKIE_SAMESITE=lax

# Seed admin (npm run db:seed). If ADMIN_PASSWORD is empty a random one is printed.
ADMIN_EMAIL=admin@letswrassleapparel.com
ADMIN_PASSWORD=

# ───────── Storage ─────────
STORAGE_DRIVER=local            # local | s3
UPLOAD_DIR=./uploads            # local driver
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=                    # e.g. https://<acct>.r2.cloudflarestorage.com (blank for AWS)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=                  # public base URL for uploaded objects

# ───────── Store rules ─────────
SHIPPING_FLAT_CENTS=599         # flat rate charged at checkout for SHIPPING orders
FREE_SHIPPING_OVER_CENTS=0      # 0 disables free shipping
TAX_RATE=0.06                   # applied to subtotal (PA sales tax)
PRIMARY_GATEWAY=SQUARE          # STRIPE | SQUARE (which tab is selected by default)

# ───────── Payments (embedded on-site checkout) ─────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=          # optional; endpoint: POST /api/checkout/stripe/webhook

SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox      # sandbox | production

# ───────── Shipping labels (Shippo) ─────────
SHIPPO_API_KEY=
SHIP_FROM_NAME=Let's Wrassle Apparel
SHIP_FROM_STREET1=
SHIP_FROM_CITY=
SHIP_FROM_STATE=PA
SHIP_FROM_ZIP=
SHIP_FROM_COUNTRY=US
SHIP_FROM_PHONE=
SHIP_FROM_EMAIL=support@letswrassleapparel.com

# ───────── Email (Nodemailer / any SMTP) ─────────
# With SMTP_HOST empty, emails are printed to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Let's Wrassle Apparel <support@letswrassleapparel.com>"
# Where "New Order" alerts go
OWNER_EMAIL=support@letswrassleapparel.com
