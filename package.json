{
  "name": "letswrassle-store",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Let's Wrassle Apparel - static storefront on Cloudflare Pages, content edited through Git",
  "scripts": {
    "catalog": "node scripts/build-catalog.mjs",
    "dev": "npm run catalog && concurrently -k -n web,fn -c green,blue \"vite --config web/vite.config.ts\" \"wrangler pages dev --port 8788 --proxy 5173\"",
    "dev:ui": "npm run catalog && vite --config web/vite.config.ts",
    "build": "node scripts/build-catalog.mjs && vite build --config web/vite.config.ts",
    "preview:full": "npm run build && wrangler pages dev dist --port 8788",
    "typecheck": "tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p functions/tsconfig.json"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^3.1.1",
    "@stripe/stripe-js": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "react-square-web-payments-sdk": "^3.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "wrangler": "^3.99.0"
  },
  "engines": {
    "node": ">=20"
  }
}
